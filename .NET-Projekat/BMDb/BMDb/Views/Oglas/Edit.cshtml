@model BMDb.Models.Oglas
@{
    Layout = "_AdminLayout";
}

@section StranicaStilovi {
    <style>
        .admin-section { padding: 50px 0; background: #020d18; color: white; min-height: 70vh; }
        .form-container { background: #0b1a2a; padding: 30px; border: 1px solid #1c3d5d; border-radius: 5px; }
        .form-container input, .form-container select, .form-container textarea { width: 100%; padding: 12px; margin: 10px 0; background: #020d18; border: 1px solid #1c3d5d; color: white; border-radius: 3px; }
        .form-container label { color: #fbb124; font-weight: bold; margin-top: 15px; display: block; }
        .form-container .checkbox-row { display: flex; align-items: center; gap: 10px; margin-top: 15px; }
        .form-container .checkbox-row input { width: auto; margin: 0; }
        .btn-submit { background: #fbb124; color: black; font-weight: bold; text-transform: uppercase; border: none; padding: 15px 30px; margin-top: 20px; cursor: pointer; transition: 0.3s; }
        .btn-submit:hover { background: #ffffff; }
    </style>
}

<div class="hero common-hero">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hero-ct">
                    <h1>Uredi oglas</h1>
                    <ul class="breadcumb">
                        <li><a asp-controller="Home" asp-action="AdminDashboard">Admin</a></li>
                        <li><a asp-controller="Home" asp-action="Finansije"><span class="ion-ios-arrow-right"></span> Finansije</a></li>
                        <li><span class="ion-ios-arrow-right"></span> Uredi</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="admin-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="form-container">
                    <form asp-controller="Oglas" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <label asp-for="Slika">Slika oglasa</label>
                        <input asp-for="Slika" placeholder="/images/uploads/ads1.png ili https://...">
                        <span asp-validation-for="Slika" class="text-danger"></span>

                        <label asp-for="Link">Link oglasa</label>
                        <input asp-for="Link" placeholder="https://...">
                        <span asp-validation-for="Link" class="text-danger"></span>

                        <label asp-for="Prihod">Prihod po prikazu</label>
                        <input asp-for="Prihod" type="number" step="0.01" min="0" placeholder="0.00">
                        <span asp-validation-for="Prihod" class="text-danger"></span>

                        <div class="checkbox-row">
                            <input asp-for="Aktivan">
                            <label asp-for="Aktivan">Aktivan</label>
                        </div>

                        <button type="submit" class="btn-submit">Sacuvaj promjene</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
