
@model IReadOnlyList<BMDb.ViewModels.ProfileReviewViewModel>
@using Microsoft.AspNetCore.Identity
@inject BMDb.Services.IMediaImageService MediaImageService
@inject UserManager<Osoba> UserManager
@{
	var currentUser = await UserManager.GetUserAsync(User);
	var avatarUrl = string.IsNullOrWhiteSpace(currentUser?.Avatar)
		? "/images/uploads/user-img.png"
		: MediaImageService.ResolvePosterUrl(currentUser.Avatar);
}

	<div class="hero user-hero">
		<div class="container">
			<div class="row">
				<div class="col-md-12">
					<div class="hero-ct">
						<h1 style="position: relative; left: -138px;">Recenzije</h1>
						<ul class="breadcumb">
							<li class="active"><a asp-controller="Home" asp-action="Glavna">Početna</a></li>
							<li><span class="ion-ios-arrow-right"></span> Recenzije</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="page-single">
		<div class="container">
			<div class="row ipad-width2">
				<div class="col-md-3 col-sm-12 col-xs-12">
					<div class="user-information">
						<div class="user-img">
							<a asp-controller="Osoba" asp-action="Details"><img class="bmd-avatar" src="@avatarUrl" alt=""><br></a>
							<a asp-controller="Osoba" asp-action="Details" class="redbtn">Promijeni avatar</a>
						</div>
						<div class="user-fav">
							<p>Detalji računa</p>
							<ul>
								<li><a asp-controller="Osoba" asp-action="Details">Profil</a></li>
								<li><a asp-controller="GledatCu" asp-action="Index">Gledat ću</a></li>
								<li><a asp-controller="GledaoSam" asp-action="Index">Gledao sam</a></li>
								<li class="active"><a asp-controller="Recenzija" asp-action="Index">Recenzije</a></li>
							</ul>
						</div>
					</div>
				</div>

				<div class="col-md-9 col-sm-12 col-xs-12">
					<div class="topbar-filter">
						<p>Pronađene <span>@Model.Count recenzije</span> ukupno</p>
						<label>Sortiraj po:</label>
						<select>
							<option value="range">-- Odaberi opciju --</option>
							<option value="saab">-- Odaberi opciju 2 --</option>
						</select>
					</div>

					@foreach (var recenzija in Model)
					{
						<div class="movie-item-style-2 userrate">
							<img src="@MediaImageService.ResolvePosterUrl(recenzija.PosterLink)" alt="">
							<div class="mv-item-infor">
								<h6><a asp-controller="@recenzija.ControllerName" asp-action="Details" asp-route-id="@recenzija.EntertainmentId">@recenzija.Naziv <span>(@recenzija.GodinaIzlaska)</span></a></h6>
								<p class="time sm-text">Vaša ocjena:</p>
								<p class="rate"><i class="ion-android-star"></i><span>@recenzija.Ocjena.ToString("0.0")</span> /10</p>
								<p class="time sm-text">Recenzija:</p>
								<h6>@recenzija.Naziv</h6>
								<p class="time sm">@recenzija.DatumObjave.ToString("dd MMMM yyyy")</p>
								<p>@recenzija.Komentar</p>
							</div>
						</div>
					}

					<div class="topbar-filter">
						<label>Filmova po stranici:</label>
						<select>
							<option value="range">@Model.Count recenzija</option>
						</select>
						<div class="pagination2">
							<span>Stranica 1 od 1:</span>
							<a class="active" asp-controller="Recenzija" asp-action="Index">1</a>
							<a asp-controller="Recenzija" asp-action="Index"><i class="ion-arrow-right-b"></i></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
