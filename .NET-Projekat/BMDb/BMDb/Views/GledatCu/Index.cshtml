
@model IReadOnlyList<BMDb.ViewModels.ProfileMediaItemViewModel>
@using Microsoft.AspNetCore.Identity
@inject BMDb.Services.IMediaImageService MediaImageService
@inject UserManager<Osoba> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var avatarUrl = string.IsNullOrWhiteSpace(currentUser?.Avatar)
        ? "/images/uploads/user-img.png"
        : MediaImageService.ResolvePosterUrl(currentUser.Avatar);
    var currentSort = ViewBag.Sort as string ?? "newest";
}

    <div class="hero user-hero">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="hero-ct">
                        <h1 style="position: relative; left: -28px;">Filmovi koje ću gledati</h1>
                        <ul class="breadcumb">
                            <li class="active"><a asp-controller="Home" asp-action="Glavna">Početna</a></li>
                            <li><span class="ion-ios-arrow-right"></span> Gledat ću</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="page-single">
        <div class="container">
            <div class="row ipad-width2">
                <div class="col-md-3 col-sm-12 col-xs-12">
                    <div class="user-information">
                        <div class="user-img">
                            <a asp-controller="Osoba" asp-action="Details"><img class="bmd-avatar" src="@avatarUrl" alt=""><br></a>
                            <a asp-controller="Osoba" asp-action="Details" class="redbtn">Promijeni avatar</a>
                        </div>
                        <div class="user-fav">
                            <p>Detalji računa</p>
                            <ul>
                                <li><a asp-controller="Osoba" asp-action="Details">Profil</a></li>
                                <li class="active"><a asp-controller="GledatCu" asp-action="Index">Gledat ću</a></li>
                                <li><a asp-controller="GledaoSam" asp-action="Index">Gledao sam</a></li>
                                <li><a asp-controller="Recenzija" asp-action="Index">Recenzije</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-9 col-sm-12 col-xs-12">
                    <div class="topbar-filter user">
                        <p>Pronađeno <span>@Model.Count naslova</span> ukupno</p>
                        <form asp-controller="GledatCu" asp-action="Index" method="get" style="display:inline;">
                            <label>Sortiraj po:</label>
                            <select name="sort" onchange="this.form.submit()">
                                  <option value="newest" selected="@(currentSort == "newest")">Najnovije dodano</option>
                                  <option value="rating" selected="@(currentSort == "rating")">Ocjena (najviša)</option>
                            </select>
                        </form>
                    </div>
                    <div class="flex-wrap-movielist grid-fav">
                        @foreach (var item in Model)
                        {
                            <div class="movie-item-style-2 movie-item-style-1 style-3">
                                <a class="bmd-poster-link" asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.EntertainmentId">
                                    <img src="@MediaImageService.ResolvePosterUrl(item.PosterLink)" alt="">
                                </a>
                                <div class="hvr-inner">
                                    <a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.EntertainmentId"> Pročitaj više <i class="ion-android-arrow-dropright"></i> </a>
                                </div>
                                <div class="mv-item-infor">
                                    <h6><a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.EntertainmentId">@item.Naziv</a></h6>
                                    <div class="bmd-genre-badges">
                                        @foreach (var zanr in item.Genres.Take(2))
                                        {
                                            <span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(zanr)">@zanr</span>
                                        }
                                    </div>
                                    <p class="rate"><i class="ion-android-star"></i><span>@item.ProsjecnaOcjena.ToString("0.0")</span> /10</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="topbar-filter">
                        <label>Filmova po stranici:</label>
                        <select>
                            <option value="range">@Model.Count naslova</option>
                        </select>

                        <div class="pagination2">
                            <span>Stranica 1 od 1:</span>
                            <a class="active" asp-controller="GledatCu" asp-action="Index" asp-route-sort="@currentSort">1</a>
                            <a asp-controller="GledatCu" asp-action="Index" asp-route-sort="@currentSort"><i class="ion-arrow-right-b"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
