@model IEnumerable<BMDb.Models.Sezona>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdSerije)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RedniBrojSezone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BrojEpizoda)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DatumPremijere)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PosterSezone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IdSerije)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RedniBrojSezone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BrojEpizoda)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DatumPremijere)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PosterSezone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdSezone">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdSezone">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdSezone">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
