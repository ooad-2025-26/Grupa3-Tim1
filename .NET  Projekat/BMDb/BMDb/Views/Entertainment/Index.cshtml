@{
    Layout = "_AdminLayout";
}

@model IEnumerable<BMDb.ViewModels.EntertainmentListItemViewModel>
@inject BMDb.Services.IMediaImageService MediaImageService

@section StranicaStilovi {
  <style>
        .admin-section { padding: 50px 0; background: #020d18; color: white; min-height: 70vh; }
        .table-custom { width: 100%; border-collapse: collapse; margin-top: 20px; background: #0b1a2a; }
        .table-custom th, .table-custom td { padding: 15px; border: 1px solid #1c3d5d; text-align: left; }
        .table-custom th { background: #06121e; color: #fbb124; }
        .action-btn { padding: 5px 12px; border-radius: 3px; cursor: pointer; border: none; margin-right: 5px; transition: 0.3s; }
        .btn-del { background: #dd163b; color: white; }
        .btn-edit { background: #fbb124; color: black; }
        .btn-details { background: #1c3d5d; color: white; }
        .admin-section .top-search { background: #0b1a2a; }
    </style>
}

<div class="hero common-hero">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hero-ct">
                    <h1>Lista svih filmova i serija</h1>
                    <ul class="breadcumb">
                        <li><a href="admin.html">Admin</a></li>
                        <li> <span class="ion-ios-arrow-right"></span> Sadržaj</li>
                        <li> <span class="ion-ios-arrow-right"></span> Lista</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="admin-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div style="margin-bottom: 20px;">
                    <h3>Pregled baze podataka</h3>
                    <a asp-controller="Film" asp-action="Create" class="action-btn btn-edit">Dodaj film</a>
                    <a asp-controller="Serija" asp-action="Create" class="action-btn btn-details">Dodaj seriju</a>
                </div>

                <form asp-controller="Entertainment" asp-action="Index" method="get">
                    <div class="top-search">
                        <input type="text" name="search" value="@ViewData["Search"]" placeholder="Pretražite filmove i TV serije koji vas zanimaju">
                    </div>
                </form>

                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Poster</th>
                            <th>Naziv</th>
                            <th>Tip</th>
                            <th>Godina</th>
                            <th>Ocjena</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><img src="@MediaImageService.ResolvePosterUrl(item.PosterLink)" alt="@item.Naziv" width="50"></td>
                                <td><strong>@item.Naziv</strong></td>
                                <td>@item.Tip</td>
                                <td>@item.GodinaIzlaska</td>
                                <td>@item.Ocjena.ToString("0.0")</td>
                                <td>
                                    <a asp-controller="@item.ControllerName" asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit">Uredi</a>
                                    <a asp-controller="@item.ControllerName" asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-del">Obriši</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

