@model BMDb.ViewModels.MediaIndexViewModel<BMDb.Models.Serija>
@inject BMDb.Services.IMediaImageService MediaImageService

<div class="hero common-hero">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hero-ct">
                    <h1>TV serije</h1>
                    <ul class="breadcumb">
                        <li class="active"><a asp-controller="Home" asp-action="Glavna">Početna</a></li>
                        <li><span class="ion-ios-arrow-right"></span> TV Serije</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="page-single">
    <div class="container">
        <div class="row ipad-width">
            <div class="col-md-8 col-sm-12 col-xs-12">
                <div class="topbar-filter">
                    <p>Pronađeno <span>@Model.Items.Count TV serija</span> ukupno</p>
                </div>

                @if (Model.NemaRezultata)
                {
                    <p style="color:#ffffff;">Nema rezultata za odabrane kriterije.</p>
                }
                else
                {
                    <div class="flex-wrap-movielist">
                        @foreach (var serija in Model.Items)
                        {
                            var poster = MediaImageService.ResolvePosterUrl(serija.PosterLink);
                            <div class="movie-item-style-2 movie-item-style-1">
                                <img src="@poster" alt="@serija.Naziv">
                                <div class="hvr-inner">
                                    <a asp-controller="Serija" asp-action="Details" asp-route-id="@serija.Id">Vidi više <i class="ion-android-arrow-dropright"></i></a>
                                </div>
                                <div class="mv-item-infor">
                                    <h6><a asp-controller="Serija" asp-action="Details" asp-route-id="@serija.Id">@serija.Naziv <span>(@serija.GodinaIzlaska)</span></a></h6>
                                    <p class="rate"><i class="ion-android-star"></i><span>@serija.ProsjecnaOcjena.ToString("0.0")</span> /10</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="col-md-4 col-sm-12 col-xs-12">
                <div class="sidebar">
                    <div class="searh-form">
                        <h4 class="sb-title">Pretraga TV serija</h4>
                        <form class="form-style-1" method="get" asp-action="Index">
                            <div class="row">
                                <div class="col-md-12 form-it">
                                    <label>Naziv ili ključna riječ</label>
                                    <input type="text" name="search" value="@Model.Filter.Search" placeholder="Unesite ključne riječi">
                                </div>
                                <div class="col-md-12 form-it">
                                    <label>Žanr</label>
                                    <select name="zanrId">
                                        <option value="">Svi žanrovi</option>
                                        @foreach (var zanr in Model.Zanrovi)
                                        {
                                            <option value="@zanr.Id" selected="@(Model.Filter.ZanrId == zanr.Id)">@zanr.Naziv</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-12 form-it">
                                    <label>Minimalna ocjena</label>
                                    <input type="number" name="minimalnaOcjena" min="1" max="10" step="0.1" value="@Model.Filter.MinimalnaOcjena">
                                </div>
                                <div class="col-md-12 form-it">
                                    <label>Godina izdanja</label>
                                    <input type="number" name="godina" value="@Model.Filter.Godina">
                                </div>
                                <div class="col-md-12 form-it">
                                    <label>Poredaj po</label>
                                    <select name="sort">
                                        <option value="rating_desc" selected="@(Model.Filter.Sort == "rating_desc")">Ocjena opadajuće</option>
                                        <option value="rating_asc" selected="@(Model.Filter.Sort == "rating_asc")">Ocjena rastuće</option>
                                        <option value="year_desc" selected="@(Model.Filter.Sort == "year_desc")">Godina opadajuće</option>
                                        <option value="year_asc" selected="@(Model.Filter.Sort == "year_asc")">Godina rastuće</option>
                                        <option value="title" selected="@(Model.Filter.Sort == "title")">Naziv</option>
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <input class="submit" type="submit" value="pretraži">
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
