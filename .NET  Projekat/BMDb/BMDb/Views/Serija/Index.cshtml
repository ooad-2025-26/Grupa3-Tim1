@model IEnumerable<BMDb.Models.Serija>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IDSerije)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BrojSezona)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BrojEpizoda)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ZavrsenoEmitovanje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Naziv)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProsjecnaOcjena)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reditelj)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GodinaIzlaska)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YoutubeLink)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Trajanje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PosterLink)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IDSerije)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BrojSezona)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BrojEpizoda)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ZavrsenoEmitovanje)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Naziv)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opis)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProsjecnaOcjena)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reditelj)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GodinaIzlaska)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YoutubeLink)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Trajanje)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PosterLink)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
