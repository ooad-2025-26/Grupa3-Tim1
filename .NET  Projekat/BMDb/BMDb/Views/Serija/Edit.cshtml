@model BMDb.Models.Serija

@{
    ViewData["Title"] = "Edit";
    var sezone = ((IEnumerable<BMDb.Models.Sezona>)(ViewBag.Sezone ?? Enumerable.Empty<BMDb.Models.Sezona>()))
        .OrderBy(x => x.RedniBrojSezone)
        .Select(x => new
        {
            redniBroj = x.RedniBrojSezone,
            brojEpizoda = x.BrojEpizoda,
            datumPremijere = x.DatumPremijere,
            posterSezone = x.PosterSezone
        });
}

<h1>Edit</h1>

<h4>Serija</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="BrojSezona" class="control-label"></label>
                <input asp-for="BrojSezona" class="form-control" />
                <span asp-validation-for="BrojSezona" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BrojEpizoda" class="control-label"></label>
                <input asp-for="BrojEpizoda" class="form-control" />
                <span asp-validation-for="BrojEpizoda" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ZavrsenoEmitovanje" /> @Html.DisplayNameFor(model => model.ZavrsenoEmitovanje)
                </label>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Naziv" class="control-label"></label>
                <input asp-for="Naziv" class="form-control" />
                <span asp-validation-for="Naziv" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Opis" class="control-label"></label>
                <input asp-for="Opis" class="form-control" />
                <span asp-validation-for="Opis" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reditelj" class="control-label"></label>
                <input asp-for="Reditelj" class="form-control" />
                <span asp-validation-for="Reditelj" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GodinaIzlaska" class="control-label"></label>
                <input asp-for="GodinaIzlaska" class="form-control" />
                <span asp-validation-for="GodinaIzlaska" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="YoutubeLink" class="control-label"></label>
                <input asp-for="YoutubeLink" class="form-control" />
                <span asp-validation-for="YoutubeLink" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Trajanje" class="control-label"></label>
                <input asp-for="Trajanje" class="form-control" />
                <span asp-validation-for="Trajanje" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PosterLink" class="control-label"></label>
                <input asp-for="PosterLink" type="text" class="form-control" />
                <span asp-validation-for="PosterLink" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="zanrIds" class="control-label">Zanrovi</label>
                <select id="zanrIds" name="zanrIds" class="form-control" multiple asp-items="ViewBag.Zanrovi"></select>
            </div>
            <div class="form-group">
                <label class="control-label">Sezone</label>
                <div id="sezone-container"></div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var existingSezone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sezone));
            var brojSezonaInput = document.getElementById('BrojSezona');
            var container = document.getElementById('sezone-container');

            function renderSezone() {
                var brojSezona = parseInt(brojSezonaInput.value || '0', 10);
                container.innerHTML = '';

                for (var i = 1; i <= brojSezona; i++) {
                    var existing = existingSezone[i - 1] || {};
                    var redniBroj = existing.redniBroj || i;
                    var brojEpizoda = existing.brojEpizoda || 0;
                    var datumPremijere = existing.datumPremijere || 0;
                    var posterSezone = existing.posterSezone || 0;
                    var row = document.createElement('div');
                    row.className = 'row';
                    row.innerHTML =
                        '<div class="col-md-3"><input name="redniBrojeviSezona" class="form-control" type="number" value="' + redniBroj + '" placeholder="Redni broj"></div>' +
                        '<div class="col-md-3"><input name="brojeviEpizodaSezona" class="form-control" type="number" value="' + brojEpizoda + '" placeholder="Broj epizoda"></div>' +
                        '<div class="col-md-3"><input name="datumiPremijereSezona" class="form-control" type="number" value="' + datumPremijere + '" placeholder="Godina premijere"></div>' +
                        '<div class="col-md-3"><input name="posteriSezona" class="form-control" type="number" value="' + posterSezone + '" placeholder="Poster sezone"></div>';
                    container.appendChild(row);
                }
            }

            brojSezonaInput.addEventListener('input', renderSezone);
            renderSezone();
        })();
    </script>
}
