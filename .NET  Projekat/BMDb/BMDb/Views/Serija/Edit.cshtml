@model BMDb.Models.Serija
@{
    Layout = "_AdminLayout";
    var sezone = ((IEnumerable<BMDb.Models.Sezona>)(ViewBag.Sezone ?? Enumerable.Empty<BMDb.Models.Sezona>()))
        .OrderBy(x => x.RedniBrojSezone)
        .Select(x => new
        {
            redniBroj = x.RedniBrojSezone,
            brojEpizoda = x.BrojEpizoda,
            datumPremijere = x.DatumPremijere,
            posterSezone = x.PosterSezone
        });
}
@section StranicaStilovi {
    <style>
        .admin-section { padding: 50px 0; background: #020d18; color: white; min-height: 70vh; }
        .form-container { background: #0b1a2a; padding: 30px; border: 1px solid #1c3d5d; border-radius: 5px; }
        .form-container input, .form-container select, .form-container textarea { width: 100%; padding: 12px; margin: 10px 0; background: #020d18; border: 1px solid #1c3d5d; color: white; border-radius: 3px; }
        .form-container select[multiple] { min-height: 140px; }
        .form-container label { color: #fbb124; font-weight: bold; margin-top: 15px; display: block; }
        .btn-submit { background: #fbb124; color: black; font-weight: bold; text-transform: uppercase; border: none; padding: 15px 30px; margin-top: 20px; cursor: pointer; transition: 0.3s; }
        .btn-submit:hover { background: #ffffff; }
    </style>
}

<div class="hero common-hero">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hero-ct">
                    <h1>Uredi seriju</h1>
                    <ul class="breadcumb">
                        <li><a asp-controller="Home" asp-action="AdminDashboard">Admin</a></li>
                        <li><span class="ion-ios-arrow-right"></span> Sadrzaj</li>
                        <li><span class="ion-ios-arrow-right"></span> Uredi</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="admin-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="form-container">
                    <form asp-controller="Serija" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="Naziv">Naslov serije</label>
                                <input asp-for="Naziv" placeholder="Npr. Breaking Bad" required>
                                <span asp-validation-for="Naziv" class="text-danger"></span>

                                <label asp-for="DatumIzlaska">Datum izlaska</label>
                                <input asp-for="DatumIzlaska" type="date">
                                <span asp-validation-for="DatumIzlaska" class="text-danger"></span>

                                <label asp-for="Trajanje">Trajanje epizode (minuta)</label>
                                <input asp-for="Trajanje" type="number" placeholder="Npr. 45">
                                <span asp-validation-for="Trajanje" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PosterLink">URL Postera (putanja)</label>
                                <input asp-for="PosterLink" type="text" placeholder="images/uploads/nova_serija.jpg">
                                <span asp-validation-for="PosterLink" class="text-danger"></span>

                                <label asp-for="YoutubeLink">YouTube trailer URL</label>
                                <input asp-for="YoutubeLink" placeholder="https://www.youtube.com/watch?v=...">
                                <span asp-validation-for="YoutubeLink" class="text-danger"></span>

                                <label asp-for="Reditelj">Reziser</label>
                                <input asp-for="Reditelj" placeholder="Npr. Vince Gilligan">
                                <span asp-validation-for="Reditelj" class="text-danger"></span>

                                <label asp-for="BrojSezona">Broj sezona</label>
                                <input asp-for="BrojSezona" type="number" placeholder="1">
                                <span asp-validation-for="BrojSezona" class="text-danger"></span>

                                <label asp-for="BrojEpizoda">Broj epizoda</label>
                                <input asp-for="BrojEpizoda" type="number" placeholder="10">
                                <span asp-validation-for="BrojEpizoda" class="text-danger"></span>

                                <label><input asp-for="ZavrsenoEmitovanje" type="checkbox" style="width:auto; margin-right:8px;"> Zavrseno emitovanje</label>

                                <label for="zanrIds">Zanrovi</label>
                                <select id="zanrIds" name="zanrIds" multiple asp-items="ViewBag.Zanrovi"></select>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Opis">Sinopsis (Kratak sadrzaj)</label>
                                <textarea asp-for="Opis" rows="6" placeholder="Unesite opis serije ovdje..."></textarea>
                                <span asp-validation-for="Opis" class="text-danger"></span>

                                <label>Sezone</label>
                                <div id="sezone-container"></div>

                                <button type="submit" class="btn-submit">Sacuvaj promjene</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var existingSezone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sezone));
        var brojSezonaInput = document.getElementById('BrojSezona');
        var container = document.getElementById('sezone-container');

        function renderSezone() {
            var brojSezona = parseInt(brojSezonaInput.value || '0', 10);
            container.innerHTML = '';

            for (var i = 1; i <= brojSezona; i++) {
                var existing = existingSezone[i - 1] || {};
                var redniBroj = existing.redniBroj || i;
                var brojEpizoda = existing.brojEpizoda || 0;
                var datumPremijere = existing.datumPremijere || 0;
                var posterSezone = existing.posterSezone || 0;
                var row = document.createElement('div');
                row.className = 'row';
                row.innerHTML =
                    '<div class="col-md-3"><input name="redniBrojeviSezona" type="number" value="' + redniBroj + '" placeholder="Redni broj"></div>' +
                    '<div class="col-md-3"><input name="brojeviEpizodaSezona" type="number" value="' + brojEpizoda + '" placeholder="Broj epizoda"></div>' +
                    '<div class="col-md-3"><input name="datumiPremijereSezona" type="number" value="' + datumPremijere + '" placeholder="Godina premijere"></div>' +
                    '<div class="col-md-3"><input name="posteriSezona" type="number" value="' + posterSezone + '" placeholder="Poster sezone"></div>';
                container.appendChild(row);
            }
        }

        brojSezonaInput.addEventListener('input', renderSezone);
        renderSezone();
    })();
</script>
