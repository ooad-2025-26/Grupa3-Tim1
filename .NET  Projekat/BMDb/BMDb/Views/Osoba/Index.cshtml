@model IReadOnlyList<BMDb.ViewModels.AdminUserViewModel>
@{
    Layout = "_AdminLayout";
}

@section StranicaStilovi {
    <style>
        .admin-section { padding: 50px 0; background: #020d18; color: white; min-height: 80vh; }
        .admin-tabs { margin-bottom: 30px; border-bottom: 1px solid #1c3d5d; }
        .admin-tabs a { color: #abb7c4; padding: 10px 20px; display: inline-block; font-weight: bold; }
        .admin-tabs a.active { color: #fbb124; border-bottom: 2px solid #fbb124; }
        .table-custom { width: 100%; border-collapse: collapse; background: #0b1a2a; }
        .table-custom th, .table-custom td { padding: 15px; border: 1px solid #1c3d5d; text-align: left; }
        .action-btn { padding: 5px 12px; border-radius: 3px; border: none; cursor: pointer; }
        .btn-del { background: #dd163b; color: white; }
        .btn-edit { background: #fbb124; color: black; }
        .role-form { display: inline-flex; gap: 8px; align-items: center; margin-right: 8px; }
        .role-form select { background: #020d18; border: 1px solid #1c3d5d; color: white; padding: 6px; }
    </style>
}

<section class="admin-section">
    <div class="container">
        <div class="admin-tabs">
            <a asp-controller="Home" asp-action="Korisnici" class="active">KORISNICI</a>
        </div>

        <h3>Lista korisnika sistema</h3>
        @if (TempData["AdminUserError"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <p style="color:#dd163b;">@error</p>
        }
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Ime i prezime</th>
                    <th>Email</th>
                    <th>Uloga</th>
                    <th>Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var rolesText = user.Roles.Count > 0 ? string.Join(", ", user.Roles) : "Bez uloge";
                    var moderatorCannotDelete = User.IsInRole("Moderator") && (user.Roles.Contains("Admin") || user.Roles.Contains("Moderator"));
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName)</td>
                        <td>@user.Email</td>
                        <td>@rolesText</td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <form class="role-form" asp-controller="Home" asp-action="ChangeUserRole" asp-route-id="@user.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <select name="role">
                                        @foreach (var role in user.AvailableRoles)
                                        {
                                            <option value="@role" selected="@(role == user.SelectedRole)">@role</option>
                                        }
                                    </select>
                                    <button type="submit" class="action-btn btn-edit">Spasi ulogu</button>
                                </form>
                            }
                            @if (!moderatorCannotDelete)
                            {
                                <form asp-controller="Home" asp-action="DeleteUser" asp-route-id="@user.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="action-btn btn-del">Ukloni</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
