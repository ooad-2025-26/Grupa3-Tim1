@{
    Layout = "_AdminLayout";
}

@section StranicaStilovi {
    <style>
        .admin-section {
            padding: 50px 0;
            background: #020d18;
            color: white;
            min-height: 80vh;
        }

        .admin-tabs {
            margin-bottom: 30px;
            border-bottom: 1px solid #1c3d5d;
        }

            .admin-tabs a {
                color: #abb7c4;
                padding: 10px 20px;
                display: inline-block;
                font-weight: bold;
            }

                .admin-tabs a.active {
                    color: #fbb124;
                    border-bottom: 2px solid #fbb124;
                }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            background: #0b1a2a;
        }

            .table-custom th, .table-custom td {
                padding: 15px;
                border: 1px solid #1c3d5d;
                text-align: left;
            }

        .action-btn {
            padding: 5px 12px;
            border-radius: 3px;
            border: none;
            cursor: pointer;
        }

        .btn-del {
            background: #dd163b;
            color: white;
        }
    </style>
}


    <section class="admin-section">
