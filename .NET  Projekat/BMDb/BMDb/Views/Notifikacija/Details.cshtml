@model BMDb.Models.Notifikacija
@inject BMDb.Services.IMediaImageService MediaImageService

	<div class="hero common-hero">
		<div class="container">
			<div class="row">
				<div class="col-md-12">
					<div class="hero-ct">
						<h1>Novosti - detalji</h1>
						<ul class="breadcumb">
							<li class="active"><a href="#">Početna</a></li>
							<li> <span class="ion-ios-arrow-right"></span>Novosti</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- blog detail section-->
	<div class="page-single">
		<div class="container">
			<div class="row">
				<div class="col-md-9 col-sm-12 col-xs-12">
					<div class="blog-detail-ct">
						<h1>Novost</h1>
						<span class="time">@Model.DatumObjave.ToString("dd MMM yyyy")</span>
						<img src="@MediaImageService.ResolvePosterUrl(Model.Slika)" alt="">
						<p>
							@Model.Tekst
						</p>

						<!-- share link -->
						<div class="flex-it share-tag">
							<div class="social-link">
								<h4>Podijeli</h4>
								<a href="#"><i class="ion-social-facebook"></i></a>
								<a href="#"><i class="ion-social-twitter"></i></a>
								<a href="#"><i class="ion-social-googleplus"></i></a>
								<a href="#"><i class="ion-social-pinterest"></i></a>
								<a href="#"><i class="ion-social-linkedin"></i></a>
							</div>
						</div>

					</div>
				</div>
				<div class="col-md-3 col-sm-12 col-xs-12">
					<div class="sidebar">
						<div class="sb-search sb-it">
							<h4 class="sb-title">Pretraga</h4>
							<input type="text" placeholder="Unesi ključne riječi">
						</div>
						<div class="ads">
							<img src="/images/uploads/ads1.png" alt="">
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end of  blog detail section-->
