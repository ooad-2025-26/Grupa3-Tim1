@model IEnumerable<BMDb.Models.Notifikacija>
@inject BMDb.Services.IMediaImageService MediaImageService

    <div class="hero common-hero">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="hero-ct">
                        <h1>Novosti</h1>
                        <ul class="breadcumb">
                            <li class="active"><a href="#">Početna</a></li>
                            <li> <span class="ion-ios-arrow-right"></span>Novosti</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- blog list section-->
    <div class="page-single">
        <div class="container">
            <div class="row">
                <div class="col-md-9 col-sm-12 col-xs-12">
                    @if (!Model.Any())
                    {
                        <p style="color:#ffffff;">Nema dostupnih novosti.</p>
                    }
                    else
                    {
                        @foreach (var notifikacija in Model)
                        {
                            <div class="blog-item-style-1 blog-item-style-3">
                                <img src="@MediaImageService.ResolvePosterUrl(notifikacija.Slika)" alt="">
                                <div class="blog-it-infor">
                                    <h3><a asp-controller="Notifikacija" asp-action="Details" asp-route-id="@notifikacija.Id">Novost</a></h3>
                                    <span class="time">@notifikacija.DatumObjave.ToString("dd MMM yyyy")</span>
                                    <p>@notifikacija.Tekst</p>
                                </div>
                            </div>
                        }
                    }
                    <ul class="pagination">
                        <li class="icon-prev"><a href="#"><i class="ion-ios-arrow-left"></i></a></li>
                        <li class="active"><a href="#">1</a></li>
                    </ul>
                </div>
                <div class="col-md-3 col-sm-12 col-xs-12">
                    <div class="sidebar">
                        <div class="sb-search sb-it">
                            <h4 class="sb-title">Pretraga</h4>
                            <input type="text" placeholder="Unesite ključne riječi">
                        </div>
                        <div class="ads">
                            <img src="/images/uploads/ads1.png" alt="">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end of blog list section-->
