@model BMDb.Models.Notifikacija
@{
    Layout = "_AdminLayout";
}

@section StranicaStilovi {
    <style>
        .admin-section { padding: 50px 0; background: #020d18; color: white; min-height: 70vh; }
        .form-container { background: #0b1a2a; padding: 30px; border: 1px solid #1c3d5d; border-radius: 5px; }
        .form-container input, .form-container select, .form-container textarea { width: 100%; padding: 12px; margin: 10px 0; background: #020d18; border: 1px solid #1c3d5d; color: white; border-radius: 3px; }
        .form-container label { color: #fbb124; font-weight: bold; margin-top: 15px; display: block; }
        .btn-submit { background: #fbb124; color: black; font-weight: bold; text-transform: uppercase; border: none; padding: 15px 30px; margin-top: 20px; cursor: pointer; transition: 0.3s; }
        .btn-submit:hover { background: #ffffff; }
    </style>
}

<div class="hero common-hero">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hero-ct">
                    <h1>Dodaj novost</h1>
                    <ul class="breadcumb">
                        <li><a asp-controller="Home" asp-action="AdminDashboard">Admin</a></li>
                        <li><span class="ion-ios-arrow-right"></span> Novosti</li>
                        <li><span class="ion-ios-arrow-right"></span> Dodaj</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="admin-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="form-container">
                    <form asp-controller="Notifikacija" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <label asp-for="Tekst">Tekst novosti</label>
                        <textarea asp-for="Tekst" rows="6" placeholder="Unesite tekst novosti..."></textarea>
                        <span asp-validation-for="Tekst" class="text-danger"></span>

                        <label asp-for="DatumObjave">Datum objave</label>
                        <input asp-for="DatumObjave" type="datetime-local">
                        <span asp-validation-for="DatumObjave" class="text-danger"></span>

                        <label asp-for="Slika">Slika</label>
                        <input asp-for="Slika" placeholder="/images/uploads/novost.jpg ili https://...">
                        <span asp-validation-for="Slika" class="text-danger"></span>

                        <button type="submit" class="btn-submit">Sacuvaj u bazu podataka</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
