@model IEnumerable<BMDb.Models.Film>
@inject BMDb.Services.IMediaImageService MediaImageService
@{
    var zanrovi = ViewBag.Zanrovi as IDictionary<int, List<string>> ?? new Dictionary<int, List<string>>();
}

    <h1>Uskoro u kinima</h1>
    <div class="slider movie-items">
        <div class="container">
            <div class="row">
                <div class="slick-multiItemSlider">
                    @foreach (var film in Model)
                    {
                        var filmZanrovi = zanrovi.TryGetValue(film.Id, out var itemZanrovi) ? itemZanrovi : new List<string>();
                        <div class="movie-item">
                            <div class="mv-img">
                                <a asp-controller="Film" asp-action="Details" asp-route-id="@film.Id"><img src="@MediaImageService.ResolvePosterUrl(film.PosterLink)" alt="@film.Naziv"></a>
                            </div>
                            <div class="title-in">
                                <div class="cate">
                                    @foreach (var zanr in filmZanrovi.Take(2))
                                    {
                                        <span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(zanr)"><a href="#">@zanr</a></span>
                                    }
                                </div>
                                <h6><a asp-controller="Film" asp-action="Details" asp-route-id="@film.Id">@film.Naziv</a></h6>
                                <p><i class="ion-android-star"></i><span>@film.ProsjecnaOcjena.ToString("0.0")</span> /10</p>
                                <p>@film.GodinaIzlaska</p>
                                @if (!string.IsNullOrWhiteSpace(film.YoutubeLink))
                                {
                                    <p><a href="@film.YoutubeLink" target="_blank" rel="noopener">Trailer</a></p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
