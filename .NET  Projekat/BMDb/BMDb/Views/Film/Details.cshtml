@model BMDb.ViewModels.MediaDetailsViewModel
@inject BMDb.Services.IMediaImageService MediaImageService
@{
    var film = Model.Entertainment as BMDb.Models.Film;
    var poster = MediaImageService.ResolvePosterUrl(Model.Entertainment.PosterLink);
    var trailer = Model.TrailerEmbedUrl ?? string.Empty;
    var recenzije = Model.Recenzije ?? Array.Empty<BMDb.Models.Recenzija>();
    var galerija = Model.Galerija ?? Array.Empty<BMDb.Models.GalerijaSlika>();
    var uloge = Model.Uloge ?? Array.Empty<BMDb.Models.Uloga>();
    var glumci = Model.Glumci ?? Array.Empty<BMDb.Models.Glumac>();
    var zanrovi = Model.Zanrovi ?? Array.Empty<BMDb.Models.Zanr>();
}

<div class="hero mv-single-hero">
	<div class="container">
		<div class="row">
			<div class="col-md-12">
			</div>
		</div>
	</div>
</div>
<div class="page-single movie-single movie_single">
	<div class="container">
		<div class="row ipad-width2">
			<div class="col-md-4 col-sm-12 col-xs-12">
				<div class="movie-img sticky-sb">
					<img src="@poster" alt="@Model.Entertainment.Naziv">
					<div class="movie-btn">
						@if (!string.IsNullOrWhiteSpace(trailer))
						{
							<div class="btn-transform transform-vertical red">
								<div>
									<a href="#bmd-trailer-popup" data-trailer-url="@trailer" class="item item-1 redbtn bmd-trigger">
										<i class="ion-play"></i> Pogledaj trailer
									</a>
								</div>
								<div>
									<a href="#bmd-trailer-popup" data-trailer-url="@trailer" class="item item-2 redbtn hvr-grow bmd-trigger">
										<i class="ion-play"></i>
									</a>
								</div>
							</div>
						}

						<div id="bmd-trailer-popup" class="bmd-modal-overlay">
							<div class="bmd-modal-content">
								<a href="#!" id="bmd-close" class="bmd-close-btn">&times;</a>
								<div class="bmd-video-wrapper">
									<iframe id="bmd-video-iframe" src="" frameborder="0" allowfullscreen></iframe>
								</div>
							</div>
						</div>
						
					</div>
				</div>
			</div>
			<div class="col-md-8 col-sm-12 col-xs-12">
				<div class="movie-single-ct main-content">
					<h1 class="bd-hd">@Model.Entertainment.Naziv <span>@Model.Entertainment.GodinaIzlaska</span></h1>
					@if (!string.IsNullOrWhiteSpace(Model.StatusPoruka))
					{
						<p style="color:#fbb124;">@Model.StatusPoruka</p>
					}
					<div class="social-btn">
						<form asp-controller="Film" asp-action="OznaciPlanirano" asp-route-id="@Model.Entertainment.Id" method="post" style="display:inline;">
							@Html.AntiForgeryToken()
							<button type="submit" class="parent-btn" style="color: #add8e6; margin-left: 20px; background:none; border:0;">
								<i class="ion-ios-play"></i> @(Model.JePlanirano ? "U planu" : "Gledat cu")
							</button>
						</form>
						<form asp-controller="Film" asp-action="OznaciGledao" asp-route-id="@Model.Entertainment.Id" method="post" style="display:inline;">
							@Html.AntiForgeryToken()
							<button type="submit" class="parent-btn" style="color: #add8e6; background:none; border:0;">
								<i class="ion-checkmark-circled"></i> @(Model.JeGledao ? "Gledano" : "Gledao sam")
							</button>
						</form>
					</div>
					<div class="movie-rate">
						<div class="rate">
							<i class="ion-android-star"></i>
							<p><span>@Model.Entertainment.ProsjecnaOcjena.ToString("0.0")</span> /10<br>
								<span class="rv">@recenzije.Count Recenzija</span>
							</p>
						</div>
						<div class="rate-star">
							<p>Ocijenite film: </p>
							@for (var i = 1; i <= 10; i++)
							{
								<i class="@(i <= Math.Round(Model.Entertainment.ProsjecnaOcjena) ? "ion-ios-star" : "ion-ios-star-outline")"></i>
							}
						</div>
					</div>
					<div class="movie-tabs">
						<div class="tabs">
							<ul class="tab-links tabs-mv">
								<li class="active"><a href="#overview">Pregled</a></li>
								<li><a href="#reviews"> Recenzije</a></li>
								<li><a href="#reviews"> Verifikovane Recenzije</a></li>
								<li><a href="#media"> Galerija</a></li>                   
							</ul>
						    <div class="tab-content">
						        <div id="overview" class="tab active">
						            <div class="row">
						            	<div class="col-md-8 col-sm-12 col-xs-12">
						            		<p>@Model.Entertainment.Opis</p>
						            		<div class="title-hd-sm">
												<h4>Fotografije</h4>
												<a href="#media" class="time">Sve fotografije <i class="ion-ios-arrow-right"></i></a>
											</div>
											<div class="mvsingle-item ov-item">
												@foreach (var slika in galerija.Take(4))
												{
													var slikaUrl = MediaImageService.ResolvePosterUrl(slika.Url);
													<a class="img-lightbox" data-fancybox-group="gallery" href="@slikaUrl"><img src="@slikaUrl" alt=""></a>
												}
											</div>
											<div class="title-hd-sm">
												<h4>Uloge</h4>
												<a href="#" class="time">Cijela postava <i class="ion-ios-arrow-right"></i></a>
											</div>
											<div class="mvcast-item">
												@foreach (var uloga in uloge)
												{
													var glumac = glumci.FirstOrDefault(x => x.Id == uloga.GlumacId);
													var slika = MediaImageService.ResolvePosterUrl(glumac?.Slika);
													<div class="cast-it">
														<div class="cast-left">
															<img src="@slika" alt="">
															<a href="#">@(glumac == null ? "Nepoznat glumac" : $"{glumac.Ime} {glumac.Prezime}")</a>
														</div>
														<p>... @uloga.ImeLika</p>
													</div>
												}
											</div>
						            	</div>
						            	<div class="col-md-4 col-xs-12 col-sm-12">
						            		<div class="sb-it">
						            			<h6>Reziser: </h6>
						            			<p><a href="#">@Model.Entertainment.Reditelj</a></p>
						            		</div>
						            		<div class="sb-it">
						            			<h6>BoxOffice: </h6>
						            			<p><a href="#">@(film?.BoxOffice.ToString("N0") ?? "0")</a></p>
						            		</div>
						            		<div class="sb-it">
						            			<h6>Zvijezde: </h6>
						            			<p>@string.Join(", ", glumci.Take(3).Select(x => $"{x.Ime} {x.Prezime}"))</p>
						            		</div>
						            		<div class="sb-it">
						            			<h6>Zanrovi:</h6>
						            			<p>@string.Join(", ", zanrovi.Select(x => x.Naziv))</p>
						            		</div>
						            		<div class="sb-it">
						            			<h6>Datum izlaska:</h6>
						            			<p>@Model.Entertainment.GodinaIzlaska</p>
						            		</div>
						            		<div class="sb-it">
						            			<h6>Trajanje:</h6>
						            			<p>@Model.Entertainment.Trajanje min</p>
						            		</div>
						            		<div class="ads">
												<img src="/images/uploads/ads1.png" alt="">
											</div>
						            	</div>
						            </div>
						        </div>
						        <div id="reviews" class="tab review">
						           <div class="row">
						            	<div class="rv-hd" style="margin-bottom: 20px;">
											@if (Model.MozeOcijeniti)
											{
												<form asp-controller="Film" asp-action="DodajRecenziju" asp-route-id="@Model.Entertainment.Id" method="post">
													@Html.AntiForgeryToken()
													<input type="number" name="ocjena" min="1" max="10" placeholder="Ocjena" style="width:90px;">
													<input type="text" name="komentar" placeholder="Komentar">
													<button type="submit" class="redbtn">Napisi recenziju</button>
												</form>
											}
										</div>
						            	<div class="topbar-filter">
											<p>Pronadeno <span>@recenzije.Count recenzija</span> ukupno</p>
										</div>
										@foreach (var recenzija in recenzije)
										{
											<div class="mv-user-review-item">
												<div class="user-infor">
													<img class="bmd-avatar" src="/images/uploads/userava1.jpg" alt="">
													<div>
														<h3>Ocjena @recenzija.Ocjena/10</h3>
														<div class="no-star">
															@for (var i = 1; i <= 10; i++)
															{
																<i class="@(i <= recenzija.Ocjena ? "ion-android-star" : "ion-android-star last")"></i>
															}
														</div>
														<p class="time">@recenzija.DatumObjave.ToLocalTime().ToString("dd.MM.yyyy.")</p>
													</div>
												</div>
												<p>@recenzija.Komentar</p>
											</div>
										}
						            </div>
						        </div>
					       	 	<div id="media" class="tab">
						        	<div class="row">
						        		<div class="rv-hd">
						            		<div>
						            			<h3>Slike iz filma</h3>
					       	 					<h2>@Model.Entertainment.Naziv</h2>
						            		</div>
						            	</div>
										<div class="title-hd-sm">
											<h4>Fotografije <span> (@galerija.Count)</span></h4>
										</div>
										<div class="mvsingle-item">
											@foreach (var slika in galerija)
											{
												var slikaUrl = MediaImageService.ResolvePosterUrl(slika.Url);
												<a class="img-lightbox" data-fancybox-group="gallery" href="@slikaUrl"><img src="@slikaUrl" alt=""></a>
											}
										</div>
						        	</div>
					       	 	</div>
						    </div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	document.querySelectorAll('.bmd-trigger').forEach(function (link) {
		link.addEventListener('click', function () {
			var iframe = document.getElementById('bmd-video-iframe');
			iframe.src = this.getAttribute('data-trailer-url') || '';
		});
	});
	document.getElementById('bmd-close')?.addEventListener('click', function () {
		document.getElementById('bmd-video-iframe').src = '';
	});
</script>
