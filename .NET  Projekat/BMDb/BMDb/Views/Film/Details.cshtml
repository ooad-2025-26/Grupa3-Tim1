@model BMDb.ViewModels.MediaDetailsViewModel
@{
    var film = (BMDb.Models.Film)Model.Entertainment;
    var poster = string.IsNullOrWhiteSpace(film.PosterLink) ? Url.Content("~/images/uploads/movie-single.jpg") : film.PosterLink;
}

<div class="hero mv-single-hero"></div>
<div class="page-single movie-single movie_single">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.StatusPoruka))
        {
            <p style="color:#f5b50a;">@Model.StatusPoruka</p>
        }
        <div class="row ipad-width2">
            <div class="col-md-4 col-sm-12 col-xs-12">
                <div class="movie-img sticky-sb">
                    <img src="@poster" alt="@film.Naziv">
                    <div class="movie-btn">
                        @if (!string.IsNullOrWhiteSpace(Model.TrailerEmbedUrl))
                        {
                            <iframe width="100%" height="240" src="@Model.TrailerEmbedUrl" title="Trailer" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        }
                        else
                        {
                            <p style="color:#ffffff;">Trailer nije dostupan ili link nije validan.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-8 col-sm-12 col-xs-12">
                <div class="movie-single-ct main-content">
                    <h1 class="bd-hd">@film.Naziv <span>@film.GodinaIzlaska</span></h1>
                    <div class="social-btn">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="OznaciPlanirano" asp-route-id="@film.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button class="parent-btn" type="submit" style="background:none;border:0;color:#add8e6;margin-left:20px;">
                                    <i class="ion-ios-play"></i> @(Model.JePlanirano ? "Planirano" : "Gledat ću")
                                </button>
                            </form>
                            <form asp-action="OznaciGledao" asp-route-id="@film.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button class="parent-btn" type="submit" style="background:none;border:0;color:#add8e6;">
                                    <i class="ion-checkmark-circled"></i> @(Model.JeGledao ? "Gledao sam" : "Označi gledano")
                                </button>
                            </form>
                        }
                    </div>
                    <div class="movie-rate">
                        <div class="rate">
                            <i class="ion-android-star"></i>
                            <p><span>@film.ProsjecnaOcjena.ToString("0.0")</span> /10<br><span class="rv">@Model.Recenzije.Count recenzija</span></p>
                        </div>
                    </div>
                    <div class="movie-tabs">
                        <div class="tabs">
                            <ul class="tab-links tabs-mv">
                                <li class="active"><a href="#overview">Pregled</a></li>
                                <li><a href="#reviews">Recenzije</a></li>
                                <li><a href="#media">Galerija</a></li>
                            </ul>
                            <div class="tab-content">
                                <div id="overview" class="tab active">
                                    <div class="row">
                                        <div class="col-md-8 col-sm-12 col-xs-12">
                                            <p>@film.Opis</p>
                                            <div class="title-hd-sm"><h4>Uloge</h4></div>
                                            <div class="mvcast-item">
                                                @foreach (var uloga in Model.Uloge)
                                                {
                                                    var glumac = Model.Glumci.FirstOrDefault(x => x.Id == uloga.GlumacId);
                                                    <div class="cast-it">
                                                        <div class="cast-left">
                                                            <img src="@(glumac?.Slika ?? Url.Content("~/images/uploads/cast1.jpg"))" alt="">
                                                            <a href="#">@(glumac == null ? "Glumac" : $"{glumac.Ime} {glumac.Prezime}")</a>
                                                        </div>
                                                        <p>... @uloga.ImeLika</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-xs-12 col-sm-12">
                                            <div class="sb-it"><h6>Režiser:</h6><p>@film.Reditelj</p></div>
                                            <div class="sb-it"><h6>BoxOffice:</h6><p>@film.BoxOffice</p></div>
                                            <div class="sb-it"><h6>Godina izlaska:</h6><p>@film.GodinaIzlaska</p></div>
                                            <div class="sb-it"><h6>Trajanje:</h6><p>@film.Trajanje min</p></div>
                                        </div>
                                    </div>
                                </div>
                                <div id="reviews" class="tab review">
                                    <div class="row">
                                        @if (User.Identity?.IsAuthenticated == true && Model.MozeOcijeniti)
                                        {
                                            <form asp-action="DodajRecenziju" asp-route-id="@film.Id" method="post" class="form-style-1">
                                                @Html.AntiForgeryToken()
                                                <div class="row">
                                                    <div class="col-md-3 form-it"><label>Ocjena</label><input type="number" name="ocjena" min="1" max="10" required></div>
                                                    <div class="col-md-9 form-it"><label>Komentar</label><textarea name="komentar"></textarea></div>
                                                    <div class="col-md-12"><input class="submit" type="submit" value="Sačuvaj recenziju"></div>
                                                </div>
                                            </form>
                                        }
                                        else if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <p style="color:#ffffff;">Ocjenjivanje je dostupno nakon oznake "Gledao sam".</p>
                                        }

                                        @foreach (var recenzija in Model.Recenzije)
                                        {
                                            <div class="mv-user-review-item">
                                                <div class="user-infor">
                                                    <img src="@Url.Content("~/images/uploads/userava1.jpg")" alt="">
                                                    <div>
                                                        <h3>Ocjena: @recenzija.Ocjena/10</h3>
                                                        <p class="time">@recenzija.DatumObjave.ToLocalTime().ToString("dd.MM.yyyy.")</p>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(recenzija.Komentar))
                                                {
                                                    <p>@recenzija.Komentar</p>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div id="media" class="tab">
                                    <div class="row">
                                        <div class="mvsingle-item">
                                            @foreach (var slika in Model.Galerija)
                                            {
                                                <a class="img-lightbox" href="@slika.Url"><img src="@slika.Url" alt="@film.Naziv"></a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
