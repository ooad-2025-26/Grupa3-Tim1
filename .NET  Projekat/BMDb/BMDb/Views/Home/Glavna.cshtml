<div class="movie-items  full-width">
    <div class="row">
        <div class="col-md-12">
            <div class="title-hd">
                <h2>TOP 10 OVE SEDMICE NA BMDb</h2>
                <a asp-controller="Film" asp-action="Index" class="viewall">Pogledaj sve <i class="ion-ios-arrow-right"></i></a>
            </div>
            <div class="tabs">
                <ul class="tab-links">
                    <li class="active"><a href="#tab1">#Filmovi</a></li>
                    <li><a href="#tab2"> #Serije</a></li>
                </ul>
                <div class="tab-content">
                    <div id="tab1" class="tab active">
                        <div class="row">
                            <div class="slick-multiItem2">
                                @foreach (var item in Model.TopRatedFilms)
                                {
                                    <div class="slide-it">
                                        <div class="movie-item">
                                            <div class="mv-img">
                                                <img src="@item.PosterUrl" alt="@item.Title">
                                            </div>
                                            <div class="hvr-inner">
                                                <a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
                                            </div>
                                            <div class="title-in">
                                                @if (item.Genres.Count > 0)
                                                {
                                                    <div class="cate">
                                                        @foreach (var zanr in item.Genres.Take(2))
                                                        {
                                                            <span class="blue"><a href="#">@zanr</a></span>
                                                        }
                                                    </div>
                                                }
                                                <h6><a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id">@item.Title @(item.Year.HasValue ? $"({item.Year})" : string.Empty)</a></h6>
                                                <p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div id="tab2" class="tab">
                        <div class="row">
                            <div class="slick-multiItem2">
                                @foreach (var item in Model.TopRatedSeries)
                                {
                                    <div class="slide-it">
                                        <div class="movie-item">
                                            <div class="mv-img">
                                                <img src="@item.PosterUrl" alt="@item.Title">
                                            </div>
                                            <div class="hvr-inner">
                                                <a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
                                            </div>
                                            <div class="title-in">
                                                @if (item.Genres.Count > 0)
                                                {
                                                    <div class="cate">
                                                        @foreach (var zanr in item.Genres.Take(2))
                                                        {
                                                            <span class="blue"><a href="#">@zanr</a></span>
                                                        }
                                                    </div>
                                                }
                                                <h6><a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id">@item.Title @(item.Year.HasValue ? $"({item.Year})" : string.Empty)</a></h6>
                                                <p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="title-hd">
                <h2>PREPORUKE ZA VAS</h2>
                <a asp-controller="Film" asp-action="Index" class="viewall">Pogledaj sve <i class="ion-ios-arrow-right"></i></a>
            </div>
            <div class="tabs">
                <div class="tab-content">
                    <div class="tab active">
                        <div class="row">
                            <div class="slick-multiItem2">
                                @foreach (var item in Model.RecommendedItems)
                                {
                                    <div class="slide-it">
                                        <div class="movie-item">
                                            <div class="mv-img">
                                                <img src="@item.PosterUrl" alt="@item.Title">
                                            </div>
                                            <div class="hvr-inner">
                                                <a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
                                            </div>
                                            <div class="title-in">
                                                @if (item.Genres.Count > 0)
                                                {
                                                    <div class="cate">
                                                        @foreach (var zanr in item.Genres.Take(2))
                                                        {
                                                            <span class="blue"><a href="#">@zanr</a></span>
                                                        }
                                                    </div>
                                                }
                                                <h6><a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id">@item.Title @(item.Year.HasValue ? $"({item.Year})" : string.Empty)</a></h6>
                                                <p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

