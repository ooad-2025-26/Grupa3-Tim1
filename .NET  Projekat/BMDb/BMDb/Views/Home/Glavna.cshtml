@model BMDb.ViewModels.HomeGlavnaViewModel

<div class="bmd-home-page">
<div class="slider movie-items" style="background: url('/images/uploads/slider-bg.jpg') no-repeat center center; background-size: cover;">
	<div class="container">
		<div class="row">
			<div class="social-link">
			</div>
			<div class="slick-multiItemSlider">
				@foreach (var item in Model.RandomMediaItems)
				{
					<div class="movie-item">
						<div class="mv-img">
							<a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id"><img src="@item.PosterUrl" alt="@item.Title" width="285" height="437"></a>
						</div>
						<div class="title-in">
							<div class="cate">
								@for (var i = 0; i < item.Genres.Take(2).Count(); i++)
								{
									<span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(item.Genres[i])"><a href="#">@item.Genres[i]</a></span>
								}
							</div>
							<h6><a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h6>
							<p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>

<div class="movie-items full-width">
	<div class="row">
		<div class="col-md-12">
			<div class="title-hd">
				<h2>TOP 10 OVE SEDMICE NA BMDb</h2>
				<a href="#" class="viewall">Pogledaj sve <i class="ion-ios-arrow-right"></i></a>
			</div>
			<div class="tabs">
				<ul class="tab-links">
					<li class="active"><a href="#tab1">#Filmovi</a></li>
					<li><a href="#tab2"> #Serije</a></li>
				</ul>
				<div class="tab-content">
					<div id="tab1" class="tab active">
						<div class="row">
							<div class="slick-multiItem2">
								@foreach (var item in Model.TopRatedFilms)
								{
									<div class="slide-it">
										<div class="movie-item">
											<div class="mv-img">
												<a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id"><img src="@item.PosterUrl" alt="@item.Title"></a>
											</div>
											<div class="hvr-inner">
												<a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
											</div>
											<div class="title-in">
												<div class="cate">
													@foreach (var zanr in item.Genres.Take(2))
													{
														<span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(zanr)"><a href="#">@zanr</a></span>
													}
												</div>
												<h6><a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h6>
												<p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					</div>
					<div id="tab2" class="tab">
						<div class="row">
							<div class="slick-multiItem2">
								@foreach (var item in Model.TopRatedSeries)
								{
									<div class="slide-it">
										<div class="movie-item">
											<div class="mv-img">
												<a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id"><img src="@item.PosterUrl" alt="@item.Title"></a>
											</div>
											<div class="hvr-inner">
												<a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
											</div>
											<div class="title-in">
												<div class="cate">
													@foreach (var zanr in item.Genres.Take(2))
													{
														<span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(zanr)"><a href="#">@zanr</a></span>
													}
												</div>
												<h6><a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h6>
												<p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					</div>
				</div>
			</div>

			@if (Model.ShowRecommendations)
			{
				<div class="title-hd">
					<h2>PREPORUKE ZA VAS</h2>
					<a href="#" class="viewall">Pogledaj sve <i class="ion-ios-arrow-right"></i></a>
				</div>
				<div class="tabs">
					<ul class="tab-links">
						<li class="active"><a href="#recommended-films">#Filmovi</a></li>
						<li><a href="#recommended-series"> #Serije</a></li>
					</ul>
					<div class="tab-content">
						<div id="recommended-films" class="tab active">
							<div class="row">
								<div class="slick-multiItem2">
									@foreach (var item in Model.RecommendedFilms)
									{
										<div class="slide-it">
											<div class="movie-item">
												<div class="mv-img">
													<a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id"><img src="@item.PosterUrl" alt="@item.Title"></a>
												</div>
												<div class="hvr-inner">
													<a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
												</div>
												<div class="title-in">
													<div class="cate">
														@foreach (var zanr in item.Genres.Take(2))
														{
															<span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(zanr)"><a href="#">@zanr</a></span>
														}
													</div>
													<h6><a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h6>
													<p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
												</div>
											</div>
										</div>
									}
								</div>
							</div>
						</div>
						<div id="recommended-series" class="tab">
							<div class="row">
								<div class="slick-multiItem2">
									@foreach (var item in Model.RecommendedSeries)
									{
										<div class="slide-it">
											<div class="movie-item">
												<div class="mv-img">
													<a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id"><img src="@item.PosterUrl" alt="@item.Title"></a>
												</div>
												<div class="hvr-inner">
													<a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id"> Vidi više <i class="ion-android-arrow-dropright"></i> </a>
												</div>
												<div class="title-in">
													<div class="cate">
														@foreach (var zanr in item.Genres.Take(2))
														{
															<span class="bmd-genre-badge @BMDb.Services.GenreBadgeHelper.CssClass(zanr)"><a href="#">@zanr</a></span>
														}
													</div>
													<h6><a asp-controller="Serija" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h6>
													<p><i class="ion-android-star"></i><span>@item.Rating.ToString("0.0")</span> /10</p>
												</div>
											</div>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</div>

<div class="trailers">
    <div class="container">
        <div class="row ipad-width">
            <div class="col-md-12">
                <div class="title-hd">
                    <h2>USKORO U KINU</h2>
                    <a asp-controller="Film" asp-action="ComingSoon" class="viewall">POGLEDAJ SVE <i class="ion-ios-arrow-right"></i></a>
                </div>
                <div class="videos">
                    <div class="slider-for-2 video-ft">
                        @foreach (var item in Model.ComingSoonFilms)
                        {
                            <div><iframe class="item-video" src="#" data-src="@item.TrailerEmbedUrl"></iframe></div>
                        }
                    </div>
                    <div class="slider-nav-2 thumb-ft">
                        @foreach (var item in Model.ComingSoonFilms)
                        {
                            <div class="item">
                                <div class="trailer-img">
                                    <a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id"><img src="@item.PosterUrl" alt="@item.Title" width="100" height="56"></a>
                                </div>
                                <div class="trailer-infor">
                                    <h4 class="desc"><a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h4>
                                    <p>@(item.Year?.ToString() ?? string.Empty)</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="ads" style="margin-top: 40px; text-align: center;">
                     <partial name="_AdPartial" />
                </div>
            </div>
        </div>
    </div>
</div>
</div>
