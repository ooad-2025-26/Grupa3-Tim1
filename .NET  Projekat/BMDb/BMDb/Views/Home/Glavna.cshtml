<div class="trailers">
    <div class="container">
        <div class="row ipad-width">
            <div class="col-md-12">
                <div class="title-hd">
                    <h2>USKORO U KINU</h2>
                    <a asp-controller="Film" asp-action="ComingSoon" class="viewall">POGLEDAJ SVE <i class="ion-ios-arrow-right"></i></a>
                </div>
                <div class="videos">
                    <div class="slider-for-2 video-ft">
                        @foreach (var item in Model.ComingSoonFilms)
                        {
                            <div><iframe class="item-video" src="#" data-src="@item.TrailerEmbedUrl"></iframe></div>
                        }
                    </div>
                    <div class="slider-nav-2 thumb-ft">
                        @foreach (var item in Model.ComingSoonFilms)
                        {
                            <div class="item">
                                <div class="trailer-img">
                                    <img src="@item.PosterUrl" alt="@item.Title" width="100" height="56">
                                </div>
                                <div class="trailer-infor">
                                    <h4 class="desc"><a asp-controller="Film" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h4>
                                    <p>@(item.Year?.ToString() ?? string.Empty)</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="ads" style="margin-top: 40px; text-align: center;">
                    <img src="images/uploads/ads2.png" alt="" width="728" height="106">
                </div>
            </div>
        </div>
    </div>
</div>
