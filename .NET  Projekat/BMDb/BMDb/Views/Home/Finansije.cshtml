@model IReadOnlyList<BMDb.ViewModels.FinanceAdRowViewModel>
@{
    Layout = "_AdminLayout";
}

@section StranicaStilovi {
    <style>
        .admin-section {
            padding: 50px 0;
            background: #020d18;
            color: white;
            min-height: 70vh;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: #0b1a2a;
        }

            .table-custom th, .table-custom td {
                padding: 15px;
                border: 1px solid #1c3d5d;
                text-align: left;
            }

            .table-custom th {
                background: #06121e;
                color: #fbb124;
            }

        .trending-up {
            color: #2ecc71;
            font-weight: bold;
        }
    </style>
}

<div class="hero common-hero">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hero-ct">
                    <h1>Pregled primanja i reklama</h1>
                    <ul class="breadcumb">
                        <li><a asp-controller="Home" asp-action="AdminDashboard">Admin</a></li>
                        <li><span class="ion-ios-arrow-right"></span> Finansije</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="admin-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3>Detaljan izvjestaj po reklamama</h3>
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Link</th>
                            <th>Prikazi</th>
                            <th>Prihod po prikazu</th>
                            <th>Ukupni prihod</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6">Nema reklama u bazi.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var oglas in Model)
                            {
                                <tr>
                                    <td>@oglas.Id</td>
                                    <td><a href="@oglas.Link" target="_blank" rel="noopener">@oglas.Link</a></td>
                                    <td>@oglas.BrojanjeOglasa</td>
                                    <td>@oglas.Prihod.ToString("0.00") KM</td>
                                    <td>@oglas.UkupniPrihod.ToString("0.00") KM</td>
                                    <td class="@(oglas.Aktivan ? "trending-up" : string.Empty)">@(oglas.Aktivan ? "Aktivan" : "Neaktivan")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
