@using Microsoft.AspNetCore.Identity
@using BMDb.Services
@inject SignInManager<Osoba> SignInManager
@inject UserManager<Osoba> UserManager
@inject IOglasService OglasService
@{
    var aktivniOglas = await OglasService.DohvatiAktivniOglasAsync();
}

<!DOCTYPE html>

<html lang="en" class="no-js">


<head>
    <!-- Basic need -->
    <title>BMDb</title>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="author" content="">
    <link rel="profile" href="#">

    <!--Google Font-->
    <link rel="stylesheet" href='http://fonts.googleapis.com/css?family=Dosis:400,700,500|Nunito:300,400,600' />
    <!-- Mobile specific meta -->
    <meta name=viewport content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone-no">

    <!-- CSS files -->
    <link rel="stylesheet" href="~/css/plugins.css">
    <link rel="stylesheet" href="~/css/style.css">

</head>
<body>
    <!--preloading-->
    <div id="preloader">
        <img class="logo" src="~/images/logo1.png" alt="" width="119" height="58">
        <div id="status">
            <span></span>
            <span></span>
        </div>
    </div>
    <!--end of preloading-->
    <!--login form popup-->
    <div class="login-wrapper" id="login-content">
        <div class="login-content">
            <a href="#" class="close">x</a>
            <h3>PRIJAVA</h3>
            <form asp-area="Identity" asp-page="/Account/Login" method="post">
                <div class="row">
                    <label for="username">
                        Korisničko ime:
                        <input type="text" name="Input.Email" id="username" required="required" />
                    </label>
                </div>

                <div class="row">
                    <label for="password">
                        Lozinka:
                        <input type="password" name="Input.Password" id="password" required="required" />
                    </label>
                </div>
                <div class="row">
                    <div class="remember">
                        <div>
                            <input type="checkbox" name="Input.RememberMe" value="true"><span>Zapamti me</span>
                        </div>
                        <a href="#">Zaboravili ste lozinku?</a>
                    </div>
                </div>
                <div class="row">
                    <button type="submit">PRIJAVI SE</button>
                </div>
            </form>
            <div class="row">
                <p>Ili putem društvenih mreža</p>
                <div class="social-btn-2">
                    <a class="fb" href="#"><i class="ion-social-facebook"></i>Facebook</a>
                    <a class="tw" href="#"><i class="ion-social-twitter"></i>twitter</a>
                </div>
            </div>
        </div>
    </div>
    <!--end of login form popup-->
    <!--signup form popup-->
    <div class="login-wrapper" id="signup-content">
        <div class="login-content">
            <a href="#" class="close">x</a>
            <h3>REGISTRACIJA</h3>
            <form asp-area="Identity" asp-page="/Account/Register" method="post">

                <div class="row">
                    <label for="ime">
                        Ime:
                        <input type="text" name="Input.Ime" id="ime" required="required" />
                    </label>
                </div>

                <div class="row">
                    <label for="prezime">
                        Prezime:
                        <input type="text" name="Input.Prezime" id="prezime" required="required" />
                    </label>
                </div>

                <div class="row">
                    <label for="nadimak">
                        Nadimak:
                        <input type="text" name="Input.Nadimak" id="nadimak" required="required" />
                    </label>
                </div>

                <div class="row">
                    <label for="email-2">
                        Vaš e-mail:
                        <input type="email" name="Input.Email" id="email-2" required="required" />
                    </label>
                </div>

                <div class="row">
                    <label for="password-2">
                        Lozinka:
                        <input type="password" name="Input.Password" id="password-2" required="required" />
                    </label>
                </div>

                <div class="row">
                    <label for="repassword-2">
                        Ponovite lozinku:
                        <input type="password" name="Input.ConfirmPassword" id="repassword-2"  required="required" />
                    </label>
                </div>

                <div class="row">
                    <button type="submit">REGISTRUJ SE</button>
                </div>
            </form>
        </div>
    </div>
    <!--end of signup form popup-->
    <!-- BEGIN | Header -->
    <header class="ht-header">
        <div class="container">
            <nav class="navbar navbar-default navbar-custom">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header logo">
                    <div class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                        <span class="sr-only">Prikaži navigaciju</span>
                        <div id="nav-icon1">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                    <a asp-controller="Home" asp-action="Glavna"><img class="logo" src="~/images/logo1.png" alt="" width="119" height="58"></a>
                </div>
                <!-- Collect the nav links, forms, and other content for toggling -->
                <div class="collapse navbar-collapse flex-parent" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav flex-child-menu menu-left">
                        <li class="hidden"><a href="#page-top"></a></li>
                        <li><a asp-controller="Home" asp-action="Glavna">Početna</a></li>

                        <li class="dropdown first">
                            <a class="btn btn-default dropdown-toggle lv1" data-toggle="dropdown" data-hover="dropdown">
                                Naslovi<i class="fa fa-angle-down" aria-hidden="true"></i>
                            </a>
                            <ul class="dropdown-menu level1">
                                <li><a asp-controller="Film" asp-action="Index">Filmovi</a></li>
                                <li class="it-last"><a asp-controller="Serija" asp-action="Index">Serije</a></li>
                            </ul>
                        </li>

                        <li class="dropdown first">
                            <a class="btn btn-default dropdown-toggle lv1" data-toggle="dropdown" data-hover="dropdown">
                                Novosti <i class="fa fa-angle-down" aria-hidden="true"></i>
                            </a>
                            <ul class="dropdown-menu level1">
                                <li><a asp-controller="Notifikacija" asp-action="Index">Vijesti</a></li>
                                <li><a asp-controller="Film" asp-action="ComingSoon">Uskoro u kinu</a></li>
                            </ul>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="dropdown first">
                                <a class="btn btn-default dropdown-toggle lv1" data-toggle="dropdown" data-hover="dropdown">
                                    Profil<i class="fa fa-angle-down" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu level1">
                                    <li><a asp-controller="GledatCu" asp-action="Index">gledat ću</a></li>
                                    <li><a asp-controller="GledaoSam" asp-action="Index">gledao sam</a></li>
                                    <li><a asp-controller="Notifikacija" asp-action="Index">notifikacije</a></li>
                                    <li><a asp-controller="Osoba" asp-action="Details">profil</a></li>
                                    <li class="it-last"><a asp-controller="Recenzija" asp-action="Index">recenzije</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="nav navbar-nav flex-child-menu menu-right">
                        <li><a href="#">Pomoć</a></li>

                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <li class="loginLink"><a href="#">Prijavi se</a></li>
                            <li class="btn signupLink"><a href="#">Registruj se</a></li>
                        }
                        else
                        {
                            <li class="btn" style="background-color: #dd4b39 !important; border: none; padding: 0;">
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Glavna", "Home", new { area = "" })" method="post" style="display: inline;">
                                    <button type="submit" style="background: none; border: none; color: #ffffff; padding: 11px 25px; cursor: pointer; font-family: 'Dosis', sans-serif; font-size: 14px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                                        Odjavi se
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
                <!-- /.navbar-collapse -->
            </nav>

            <!-- top search form -->
            <div class="top-search">
                <input type="text" placeholder="Pretražite filmove i TV serije koji vas zanimaju

">
            </div>
        </div>
    </header>
    <!-- END | Header -->
    @RenderBody()

    @if (aktivniOglas != null)
    {
        <div class="container" style="margin-top:20px;margin-bottom:20px;">
            <div class="ads">
                <a href="@aktivniOglas.Link" target="_blank" rel="noopener">
                    <img src="@aktivniOglas.Slika" alt="Oglas">
                </a>
            </div>
        </div>
    }


    <!-- footer section-->
    <footer class="ht-footer">
        <div class="container">
            <div class="flex-parent-ft">
                <div class="flex-child-ft item1">
                    <a asp-controller="Home" asp-action="Glavna"><img class="logo" src="~/images/logo1.png" alt=""></a>
                    <p>
                        Zmaja od Bosne bb<br>
                        Sarajevo, KS 71000
                    </p>
                    <p>Kontaktirajte nas: <a href="mailto:bmdb@gmail.com">bmdb@gmail.com</a></p>
                </div>

                <div class="flex-child-ft item2">
                    <h4>Informacije</h4>
                    <ul>
                        <li><a href="#">O nama</a></li>
                        <li><a href="#">Kontakt</a></li>
                        <li><a asp-controller="Notifikacija" asp-action="Index">Vijesti</a></li>
                    </ul>
                </div>

                <div class="flex-child-ft item3">
                    <h4>Pravne informacije</h4>
                    <ul>
                        <li><a href="#">Uslovi korištenja</a></li>
                        <li><a href="#">Politika privatnosti</a></li>
                        <li><a href="#">Sigurnost</a></li>
                    </ul>
                </div>

                @if (SignInManager.IsSignedIn(User))
                        {
                <div class="flex-child-ft item4">
                    <h4>Profil</h4>
                    <ul>
                       
                            <li><a asp-controller="Osoba" asp-action="Details">Moj profil</a></li>
                            <li><a asp-controller="GledaoSam" asp-action="Index">Gledao sam</a></li>
                            <li><a asp-controller="GledatCu" asp-action="Index">Gledat ću</a></li>  
                        
                    </ul>
                </div>
                }
                <div class="flex-child-ft item5">
                    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Admin")))
                    {
                        <h4>Admin alati</h4>
                        <a asp-controller="Home" asp-action="AdminDashboard" class="btn">Admin opcije <i class="ion-ios-arrow-forward"></i></a>
                    }
                </div>
            </div>
        </div>
        <div class="ft-copyright">
            <div class="ft-left">
                <p><a target="_blank" ref="https://github.com/ooad-2025-26/Grupa3-Tim1">&copy; 2026 BMDb. Sva prava zadr�ana.</a></p>
            </div>
            <div class="backtotop">
                <p><a href="#" id="back-to-top">Natrag na vrh  <i class="ion-ios-arrow-thin-up"></i></a></p>
            </div>
        </div>
    </footer>
    <!-- end of footer section-->

    <script src="~/js/jquery.js"></script>
    <script src="~/js/plugins.js"></script>
    <script src="~/js/plugins2.js"></script>
    <script src="~/js/custom.js"></script>
    <!-- force skok na vrh-->
    <script>
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }
        function forceScrollToTop() {
            window.scrollTo(0, 0);
            document.documentElement.scrollTop = 0;
            document.body.scrollTop = 0;
        }
        forceScrollToTop();
        let scrollInterval = setInterval(forceScrollToTop, 10);
        setTimeout(function() {
            clearInterval(scrollInterval);
        }, 2000);
        window.addEventListener('load', forceScrollToTop);
    </script>
</body>


</html>

